# Bring! Shopping List Credentials
BRING_EMAIL=deine-email@example.com
BRING_PASSWORD=dein-passwort

# Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-...

# Anzahl Personen im Haushalt
HOUSEHOLD_SIZE=2

# Anzahl Tage fuer den Essensplan (Standard: 7)
MEAL_PLAN_DAYS=7

# Essensvorlieben / Einschraenkungen (kommagetrennt)
# z.B.: vegetarisch, glutenfrei, keine Nuesse
DIETARY_PREFERENCES=

# Vegane Tage (kommagetrennt, deutsch)
# z.B.: Mittwoch, Freitag
VEGAN_DAYS=Mittwoch, Freitag

# ALDI-Modus: nur Zutaten vorschlagen, die bei ALDI erhaeltlich sind
# true oder false
ALDI_MODE=false
